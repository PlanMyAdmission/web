rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /testimonials/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /blog-covers/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /profile_pictures/{fileName} {
      allow read: if signedIn() && fileName.matches('^' + request.auth.uid + '\\..+$');
      allow write: if signedIn() &&
        fileName.matches('^' + request.auth.uid + '\\..+$') &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /documents/{fileName} {
      allow read: if signedIn() && fileName.matches('^' + request.auth.uid + '_.*$');
      allow write: if signedIn() &&
        fileName.matches('^' + request.auth.uid + '_.*$') &&
        request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
